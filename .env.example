# คัดลอกเป็น .env แล้วแก้ค่า (.env ไม่เข้า git) — ค่าเริ่มต้นอยู่ใน app/config.py
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=                 # dev ไม่ต้องใส่; ของจริงต้องมี
# QDRANT_TIMEOUT=30
# COLLECTION_PUBLIC=rag_public
# COLLECTION_PRIVATE=rag_private  # Public/Private แยก collection (PLAN.md ข้อ 8)
EMBEDDING_MODEL=BAAI/bge-m3
VECTOR_SIZE=1024                  # ต้องตรงกับโมเดล embedding; เปลี่ยนแล้วต้องสร้าง collection ใหม่
CHUNK_TARGET_CHARS=1000           # ขนาด chunk เป้าหมายตอน index (ตัดตามขอบประโยค)
# EMBEDDING_DEVICE=auto           # auto | cpu | cuda (auto = cuda ถ้ามี ไม่งั้น cpu; CPU ใช้ fp32)
# OCR_BACKEND=auto                # auto | typhoon-local | tesseract-local (auto = typhoon เมื่อมี GPU ไม่งั้น tesseract)
# EMBEDDING_DTYPE=bf16            # bf16 | fp16 | fp32 (บน GPU; CPU ใช้ fp32 เสมอ)
# EMBEDDING_MAX_LENGTH=2048
# EMBEDDING_BATCH_SIZE=16
# SEARCH_MODE=dense+sparse_bge    # dense | dense+sparse_bge | dense+sparse_bm25 | all
# EMBEDDING_TEST_MODE=1           # ใช้ hash vector แทน BGE-M3 — เฉพาะ test เท่านั้น ห้ามเปิดตอน ingest จริง
# --- API (contract v1) ---
# SERVICE_KEY=change-me           # ค่าที่ Gateway ส่งใน X-Service-Key (placeholder; ของจริง mTLS/signed token) ไม่ตั้ง = 401 ทุก request
# SYSTEM_ADMIN_USERS=u001,u002    # user_id ที่สร้างกล่องได้ (คั่นด้วยจุลภาค)
# RETRIEVE_MIN_SCORE=0.3          # placeholder จนกว่าจะ calibrate
# MAX_UPLOAD_BYTES=52428800       # 50 MB
